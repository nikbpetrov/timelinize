    {
      "id": "no-empty-unlinked-items",
      "sql": "select count(*) from items where data_text is null and data_file is null and latitude is null and retrieval_key is null and id not in (select from_item_id from relationships where from_item_id is not null) and id not in (select to_item_id from relationships where to_item_id is not null)",
